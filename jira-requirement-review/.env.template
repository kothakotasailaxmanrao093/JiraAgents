# Jira Requirement Review agent: settings. Packed into the published agent, never in git.
# Copy to .env and fill in the blanks.
# Only what differs from the code's defaults is here; every other setting keeps
# its default (listed in .env.template).


# Jira site and the login the agent reads tickets and posts reviews with
JIRA_BASE_URL=https://jiraagentdemo.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# The card's memory (2026-10-30): questions and answers, ranked services, and the
# project's history of cards, TDDs, PRs and merges. Without these the review runs
# as before, with no memory.
MEMSY_API_KEY=
MEMSY_BASE_URL=https://api.memsy.io/v1
# The same key Planning uses: the memory is encrypted before it leaves the agent.
CODE_GRAPH_KEY=

# --- Optional: every setting below is at its default; uncomment to change one ---
# LLM_MODEL_ID=gpt-5.1                 AI model that writes the review
# NOTIFICATIONS_BASE_URL=              Aetherion notifications service, for the review email
# JIRA_NOTIFY_EMAILS=                  who gets the review email (the email is switched off for now)
