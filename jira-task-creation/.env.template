# Aetherion — configuration template
#
# Copy to .env and fill in the values. Every setting is listed here; only the
# four under REQUIRED must be set. Lines marked SECRET must never be committed.
#
# See README.md for what each one does in more detail.

# ==========================================================================
# REQUIRED — the agent will not run without these
# ==========================================================================

# Your Atlassian site address, with no trailing slash.
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=

# The Jira account the agent acts as.
# Every ticket it creates will show this user as the creator.
JIRA_EMAIL=

# SECRET. Token for the account above.
# Create one at id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# SECRET. Shared secret proving a delivery really came from Jira.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LTW_WEBHOOK_SECRET=

# ==========================================================================
# SAFETY — set these before production
# ==========================================================================

# Comma-separated projects the agent may write to.
# Blank means any project. Strongly recommended in production.
LTW_ALLOWED_PROJECT_KEYS=

# true refuses every Jira write, for a safe dry run.
# The breakdown is still produced and reported.
LTW_READ_ONLY=false

# true refuses to run when the AI model is unreachable.
# false uses the deterministic fallback instead — the tickets still appear, but
# the wording is generic, and the reply comment and email both say so.
# Set this explicitly before production; the publish preflight insists on it.
LTW_REQUIRE_LLM=false

# SECRET. Alternative to LTW_WEBHOOK_SECRET, for Jira System Webhooks.
# Jira generates this one; either secret is enough on its own.
LTW_JIRA_WEBHOOK_SECRET=

# ==========================================================================
# JIRA
# ==========================================================================

# Default project for manual runs, e.g. FL.
# Ignored in webhook mode, where the project comes from the ticket.
JIRA_PROJECT_KEY=

# Board used for sprint placement.
# Blank lets the agent find the project's board itself.
JIRA_BOARD_ID=

# What your project calls an Epic.
# Change only if your project renamed it.
JIRA_EPIC_ISSUE_TYPE=Epic

# What your project calls a Story.
# Change only if your project renamed it.
JIRA_STORY_ISSUE_TYPE=Story

# What your project calls a Sub-task.
# Change only if your project renamed it.
JIRA_SUBTASK_ISSUE_TYPE=Sub-task

# Custom field linking a Story to its Epic.
# Only needed on older Jira projects; blank means auto-detect.
JIRA_EPIC_LINK_FIELD_ID=

# ==========================================================================
# BEHAVIOUR
# ==========================================================================

# The word in a comment that starts a run.
# Comment '@Aetherion <your requirement>' on any ticket.
LTW_TRIGGER_KEYWORD=Aetherion

# Label added to a ticket once its request is answered.
# Stops the next webhook delivery re-running the same work.
LTW_PROCESSED_LABEL=ltw-processed

# Label added when the agent needs a human to answer.
# Used for duplicates and clarification questions.
LTW_AWAITING_LABEL=ltw-awaiting-input

# How alike two titles must be to count as the same work.
# 0 to 1. Higher is stricter; 0.75 is deliberately cautious.
LTW_DUPLICATE_THRESHOLD=0.75

# Ask the model about pairs that scored close but did not cross the line.
# Word overlap cannot tell a reword from a sibling capability; this can.
LTW_DUPLICATE_ADJUDICATE=true

# The bottom of that band. Below it two titles share too little wording to be
# worth asking about. Titles are normalised before comparison, so a genuine
# reword often scores as low as 0.40.
LTW_DUPLICATE_ADJUDICATE_FLOOR=0.30

# The same test, applied to ticket descriptions.
# Catches work whose title is worded differently.
LTW_DESCRIPTION_MATCH_THRESHOLD=0.85

# How much of a requirement must already exist to count as done.
# Catches a re-post the generator happened to word differently.
LTW_REQUIREMENT_MATCH_THRESHOLD=0.80

# true lets Done and Won't Do tickets block new requests.
# false is correct: a decision not to build is not a duplicate.
LTW_MATCH_CLOSED_WORK=false

# How many existing tickets to compare a request against.
# Read newest first, following every page of results.
LTW_MAX_CONTEXT_ISSUES=300

# Size budget for the assembled requirement.
# Lowest-value sections are dropped first, and it says which.
LTW_CONTEXT_MAX_CHARS=24000

# Friendly project name used in messages.
# Blank uses the name Jira already holds.
LTW_PROJECT_NAME=

# What this project is about, for relevance checks.
# Blank uses the description Jira already holds.
LTW_PROJECT_DESCRIPTION=

# Domains treated as in-scope for this project.
# Blank applies no domain check.
LTW_ALLOWED_DOMAINS=

# ==========================================================================
# CONFLUENCE
# ==========================================================================

# Read Confluence pages a ticket links to.
# Only pages on the same site as JIRA_BASE_URL are ever fetched.
LTW_CONFLUENCE_ENABLED=true

# How many linked pages to read per ticket.
# Anything beyond this is reported, not silently skipped.
LTW_CONFLUENCE_MAX_PAGES=5

# How much of each page to read.
# Longer pages are truncated and the reply says so.
LTW_CONFLUENCE_MAX_CHARS=20000

# Read files attached to a linked Confluence page.
# The spec is often the attached sheet, not the page body.
LTW_CONFLUENCE_READ_ATTACHMENTS=true

# ==========================================================================
# ATTACHMENTS
# ==========================================================================

# How many attached files to read per ticket.
# PDF, Word, Excel, PowerPoint, CSV and text are supported.
LTW_ATTACHMENT_MAX_FILES=10

# Largest single attachment to download, in bytes.
# Default is 10 MB.
LTW_ATTACHMENT_MAX_BYTES=10485760

# How much text to keep from each attachment.
# Anything longer is truncated and noted.
LTW_ATTACHMENT_MAX_CHARS=20000

# Read images (screenshots, mockups) through a vision model.
# Costs a model call each and slows the run; false turns it off.
LTW_ATTACHMENT_READ_IMAGES=true

# How many attachments are downloaded and read at the same time (at least 1).
# 4 keeps well inside Jira Cloud's per-account rate limit; serial reading of
# four files took about 3 s (BGV-69), four at once about 1 s.
LTW_READ_CONCURRENCY=4

# Duplicate check against EVERY ticket in the project, kept in memory: the
# first build after a worker starts reads the whole project once, later builds
# ask Jira only what changed. false: only the newest LTW_MAX_CONTEXT_ISSUES.
LTW_DUPLICATE_INDEX=true
# A full re-read this often drops tickets that were deleted or moved
# (a match is checked to still exist before it is reported anyway).
LTW_INDEX_FULL_REFRESH_HOURS=24

# ---- speed (2026-09-30) ----------------------------------------------------
# Plan the breakdown first, then write its Stories at the same time (6+ listed
# requirement lines). The draft passes exactly the same checks; if anything
# fails, the one-call breakdown runs as before. false: always one call.
LTW_PARALLEL_BREAKDOWN=true
# How many Stories are written at the same time.
LTW_LLM_CONCURRENCY=6
# How many tickets are created in Jira at the same time.
LTW_WRITE_CONCURRENCY=4
# A quicker model for the two yes/no checks only (is it a requirement? is the
# ticket related?). Empty: the main model. If it fails, the main model answers.
LTW_LLM_FAST_MODEL=

# ==========================================================================
# LOCAL PDF — optional
# ==========================================================================

# true: "@Aetherion build" makes the whole work breakdown into a PDF and EMAILS
# it to LTW_NOTIFY_EMAILS; the reply on the ticket says so and lists what it
# proposes. NO Jira ticket is created, converted, labelled, edited or attached
# to. false: the tickets are built.
GENERATE_LOCAL_PDF=false

# ==========================================================================
# EMAIL ALERTS — optional
# ==========================================================================

# Gmail account alerts are sent from.
# Leave blank to disable email entirely.
GMAIL_SENDER=

# SECRET. A 16-character Google app password.
# This is not your account password; create it in Google security.
GMAIL_APP_PASSWORD=

# SMTP server for the sender above.
# Leave as is for Gmail.
GMAIL_SMTP_HOST=smtp.gmail.com

# SMTP port, 587 for STARTTLS.
# Leave as is for Gmail.
GMAIL_SMTP_PORT=587

# Comma-separated people who receive alerts.
# Alerts go out for duplicates, questions and failures.
LTW_NOTIFY_EMAILS=

# Who hears about system failures (expired token, Jira API error).
# Empty sends them to LTW_NOTIFY_EMAILS instead.
LTW_ADMIN_EMAILS=

# Seconds an identical email is suppressed for, so a retry storm
# cannot mail the same message repeatedly. 0 turns this off.
LTW_EMAIL_REPEAT_WINDOW=900

# Which outcomes send an email. Any of: clarification, duplicates, failed,
# created. An email means a person has something to do.
LTW_NOTIFY_ON=clarification,duplicates,failed

# ==========================================================================
# AI MODEL — optional
# ==========================================================================

# Model provider used for wording and triage.
# Without a model nothing is created — there is no fallback (2026-09-25).
LTW_LLM_PROVIDER=openai

# Model name at that provider.
# Without it the deterministic fallback runs instead.
LTW_LLM_MODEL=gpt-4o

# Most output tokens the model may return per call. A Large breakdown (an Epic,
# a dozen Stories and their Sub-tasks) is long; too low a limit cuts the answer
# off mid-JSON. Blank means 16000, within gpt-4o's 16,384 output cap — lower
# it if you switch to a model with a smaller cap.
LTW_LLM_MAX_TOKENS=

# ==========================================================================
# SERVICE
# ==========================================================================

# true runs the agent inside the webhook process.
# Set false when the Aetherion platform runs it instead.
LTW_LOCAL_EXECUTION=true

# Window in which repeat deliveries collapse into one run.
# Jira retries, and people click twice.
LTW_WEBHOOK_DEBOUNCE_SECONDS=10

# How many runs may happen at once.
# Keeps a burst of comments from stampeding Jira.
LTW_WEBHOOK_MAX_CONCURRENT=2

# Aetherion platform queue for agent workflows.
# Supplied by the platform; leave blank when running standalone.
AETHERION_AGENT_TASK_QUEUE=

# Aetherion platform queue for tool activities.
# Supplied by the platform; leave blank when running standalone.
AETHERION_TOOL_TASK_QUEUE=
