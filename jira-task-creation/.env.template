# Jira Task Creation agent: settings. Packed into the published agent, never in git.
# Copy to .env and fill in the blanks.
# Only what differs from the code's defaults is here; every other setting keeps its
# default (listed in .env.template).


# Jira site and the login the agent reads and writes with
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Project used when a form run gives no Issue Key and no Project Key
JIRA_PROJECT_KEY=FL

# Projects the agent may create tickets in; any other project is refused
TASK_ALLOWED_PROJECT_KEYS=FL,BGV

# Confluence pages are read only from this site
TASK_ALLOWED_DOMAINS=jiraagentdemo.atlassian.net

# AI model that writes the breakdown, and a quicker one for yes/no checks
TASK_LLM_MODEL=gpt-5.1
TASK_LLM_FAST_MODEL=gpt-4o-mini

# Stop the run if the AI model is unreachable, instead of writing generic tickets
TASK_REQUIRE_LLM=true

# true = every build ends in a PDF, nothing created (the form's Output overrides it);
# false = a build creates the Jira work items
GENERATE_LOCAL_PDF=false

# Gmail account that sends the emails (an app password, not the login password)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Who receives the PDFs, questions and failure emails
TASK_NOTIFY_EMAILS=

# Which outcomes send an email (never on a successful creation); none = no email at all
TASK_NOTIFY_ON=none

# --- Optional: every setting below is at its default; uncomment to change one ---
# TASK_CONTEXT_MAX_CHARS=60000          most the model is given; longer cards are condensed, never refused
# TASK_ATTACHMENT_MAX_CHARS=1000000     characters read per attached file
# TASK_ATTACHMENT_MAX_FILES=10          attachments read per ticket
# TASK_ATTACHMENT_MAX_BYTES=10485760    largest attachment read (10 MB)
# TASK_ATTACHMENT_READ_IMAGES=true      describe images with the vision model
# TASK_CONFLUENCE_ENABLED=true          follow Confluence links on the ticket
# TASK_CONFLUENCE_MAX_PAGES=5           linked pages read per ticket
# TASK_CONFLUENCE_MAX_CHARS=1000000     characters read per page
# TASK_CONFLUENCE_READ_ATTACHMENTS=true read files attached to those pages
# TASK_DUPLICATE_THRESHOLD=0.75         how similar a title must be to count as a duplicate
# TASK_DESCRIPTION_MATCH_THRESHOLD=0.85 same, for descriptions
# TASK_REQUIREMENT_MATCH_THRESHOLD=0.80 same, for a whole requirement
# TASK_MATCH_CLOSED_WORK=false          also compare against Done tickets
# TASK_MAX_CONTEXT_ISSUES=300           existing tickets read for context
# TASK_DUPLICATE_INDEX=true             keep a full index of the project for duplicate checks
# TASK_INDEX_FULL_REFRESH_HOURS=24      how often that index is rebuilt in full
# TASK_READ_ONLY=false                  true = never write to Jira (a safety switch)
# TASK_TRIGGER_KEYWORD=Aetherion        the name people @mention to ask the agent
# TASK_PROCESSED_LABEL=ltw-processed    label put on a ticket once answered
# TASK_AWAITING_LABEL=ltw-awaiting-input  label while waiting for answers
# TASK_ADMIN_EMAILS=                    who hears about failures (default: TASK_NOTIFY_EMAILS)
# TASK_EMAIL_REPEAT_WINDOW=900          seconds before the same email may be sent again
# TASK_LLM_PROVIDER=openai              AI provider name at the gateway
# TASK_PARALLEL_BREAKDOWN=true          write Stories in parallel
# TASK_LLM_CONCURRENCY=6                Stories written at the same time
# TASK_READ_CONCURRENCY=4               attachments downloaded at the same time
# TASK_WRITE_CONCURRENCY=4              Jira tickets created at the same time
# JIRA_BOARD_ID=                        board for "current sprint" (default: found from the project)
# JIRA_EPIC_LINK_FIELD_ID=              Epic Link field (default: looked up on the site)
# JIRA_EPIC_ISSUE_TYPE=Epic             issue type names, if a project renames them
# JIRA_STORY_ISSUE_TYPE=Story
# JIRA_SUBTASK_ISSUE_TYPE=Sub-task
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
