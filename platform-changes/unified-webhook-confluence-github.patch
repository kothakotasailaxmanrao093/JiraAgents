+"""Unit tests for providers/confluence.py."""
+
+import sys
+from pathlib import Path
+
+import pytest
+
+_unified_dir = Path(__file__).resolve().parent.parent
+if str(_unified_dir) not in sys.path:
+    sys.path.insert(0, str(_unified_dir))
+
+from providers.base import TenantResolutionError
+from providers.confluence import ConfluencePlugin
+
+# What the Confluence Automation rule's "Send web request" posts.
+RULE_BODY = {
+    "event": "comment_created",
+    "page_id": "16908289",
+    "comment_id": "16700001",
+    "page_title": "BTS-12 - TDD v1.2",
+    "space_key": "BTS",
+    "author_id": "acc-1",
+    "author_name": "Priya",
+}
+
+
+class TestVerifySignature:
+    def test_valid_shared_secret_passes(self):
+        headers = {"x-confluence-webhook-secret": "s3cr3t"}
+        assert ConfluencePlugin().verify_signature(headers, b"{}", {"webhook_secret": "s3cr3t"})
+
+    def test_wrong_secret_fails(self):
+        headers = {"x-confluence-webhook-secret": "wrong"}
+        assert not ConfluencePlugin().verify_signature(headers, b"{}", {"webhook_secret": "s3cr3t"})
+
+    def test_missing_configured_secret_fails(self):
+        headers = {"x-confluence-webhook-secret": "x"}
+        assert not ConfluencePlugin().verify_signature(headers, b"{}", {})
+
+    def test_missing_header_fails(self):
+        assert not ConfluencePlugin().verify_signature({}, b"{}", {"webhook_secret": "s3cr3t"})
+
+
+class TestIdentifyTenant:
+    def test_resolves_via_query_param(self):
+        assert ConfluencePlugin().identify_tenant({}, {}, {"tenant_id": "t-1"}, {}) == "t-1"
+
+    def test_missing_query_param_raises(self):
+        with pytest.raises(TenantResolutionError, match="tenant_id"):
+            ConfluencePlugin().identify_tenant({}, {}, {}, {})
+
+
+class TestToCanonical:
+    def test_rule_body_becomes_page_commented_with_flat_fields(self):
+        event = ConfluencePlugin().to_canonical({}, RULE_BODY, "t-1", {})
+        assert event.event_source == "confluence"
+        assert event.event_type == "page.commented"
