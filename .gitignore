# Tool caches — these appear at the repo root whenever a linter or test run is
# started from here rather than from inside an agent.
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

.DS_Store

# Build output. `aetherion publish` deletes its own artifact; scripts/build_package.py
# leaves one behind on purpose so it can be inspected before shipping.
dist/

# Never commit a real environment file: it ships inside the deploy artifact.
.env

# The Planning agent is its own repo (github.com/suhaniimittal/planning-agent),
# cloned here to work on side by side; never commit it into this one.
planning-agent/

# Local runs (scripts/run_local.sh): the OpenAI key and the workers' logs.
.env.local
.local-logs/
# Planning documents saved by scripts/show_planning_inputs.py --save
planning-tdds/
# Downloadable copies of the agent documents
docs-export/
# The Coding agent is its own repo (github.com/suhaniimittal/coding-agent); never commit it here.
coding-agent/
