# Jira Orchestration — configuration
#
# Copy to .env and fill in. NOTE: .env ships INSIDE the deploy artifact, so
# whatever is here at publish time is what production uses. scripts/publish.py
# prints what would ship, with secrets masked.

# ---------------------------------------------------------------------------
# Jira — the account that POSTS THE REPLY
# ---------------------------------------------------------------------------
# This account is the author of every reply comment and the stamper of every
# label. It needs permission to comment on, and edit labels of, every project
# the router answers in. It does NOT need permission to create issues — the
# children do that with their own credentials.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------------------------------------------------------------------------
# What makes the router act
# ---------------------------------------------------------------------------
# The word a comment must contain. Whole-word, case-insensitive.
# WARNING: do not set this to anything contained in the signature
# "AetherionAgent", or the system will answer its own replies forever.
ORCH_TRIGGER_KEYWORD=Aetherion

# Stamped on an issue once a comment has been answered.
ORCH_PROCESSED_LABEL=aetherion-processed

# How long an answered comment id is remembered, so a Jira redelivery is
# recognised as a duplicate rather than answered twice.
ORCH_IDEMPOTENCY_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Projects this deployment may answer in, comma-separated. Empty means any
# project the token can reach. Set it to cap the blast radius.
ORCH_ALLOWED_PROJECT_KEYS=

# true composes replies but posts NOTHING. For watching what it would say on a
# live project without touching it. Set false in production.
ORCH_READ_ONLY=false

# The Jira account id the system posts as, if known. Optional: the signature
# check works without it, but this makes the self-guard cheaper and immune to
# someone quoting a reply back.
ORCH_BOT_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Classification (Layer 2)
# ---------------------------------------------------------------------------
# Only called when a comment has no explicit verb. An unreachable model makes
# the router ASK rather than guess, so this failing is safe.
ORCH_CLASSIFIER_MODEL=gpt-5.1
# AI Gateway provider for that model. Leave blank to infer it from the model
# id (gpt-* -> openai, claude-* -> anthropic, gemini-* -> gemini).
ORCH_CLASSIFIER_PROVIDER=

# ---------------------------------------------------------------------------
# Email — the router sends the one email per run (children stand down)
# ---------------------------------------------------------------------------
# Who receives outcome emails AND admin alerts (a child unreachable, a reply
# that would not post). Comma-separated.
ORCH_NOTIFY_EMAILS=

# Which outcomes email: any of created, clarification, duplicates, failed.
# Blank means all four. An invalid request never emails, whatever this says.
ORCH_NOTIFY_ON=clarification,duplicates,failed

# Seconds an identical email is suppressed for, so a retry cannot flood the
# inbox. 0 turns suppression off.
ORCH_EMAIL_REPEAT_WINDOW=900

# The sending Gmail account — the same one the work-breakdown agent uses.
# GMAIL_APP_PASSWORD is a SECRET: a 16-character app password
# (https://myaccount.google.com/apppasswords), not the account password.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# ---------------------------------------------------------------------------
# Per-agent task queue overrides
# ---------------------------------------------------------------------------
# Each agent's worker polls a queue assigned by the platform at publish time —
# not knowable from source. Without these, dispatching a child workflow
# defaults to the ROUTER's own queue, and the child fails immediately:
# "Workflow class <X> is not registered on this worker". Find the real value
# in the Temporal UI: open that agent's own "DeployComponentWorkflow"
# registration run and read its Result — the queue is "<agent_id>-task-queue".
ORCH_TASK_QUEUE_JIRA_TASK_CREATION=
ORCH_TASK_QUEUE_JIRA_REQUIREMENT_REVIEW=
