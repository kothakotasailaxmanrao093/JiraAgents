# Jira Orchestration agent (the router): settings. Packed into the published agent, never in git.
# Copy to .env and fill in the blanks.
# Only what differs from the code's defaults is here; every other setting keeps
# its default (listed in .env.template).


# Jira site and the login the router reads comments and replies with
JIRA_BASE_URL=https://jiraagentdemo.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Projects the router answers in; comments anywhere else are ignored
ORCH_ALLOWED_PROJECT_KEYS=FL,BGV

# AI model that decides build / review / question when no verb says so
ORCH_CLASSIFIER_MODEL=gpt-5-mini

# Who receives the router's emails, and which outcomes send one; none = no email at all,
# replies on the ticket only (alerts are still logged)
ORCH_NOTIFY_EMAILS=
ORCH_NOTIFY_ON=none

# Gmail account that sends the emails (an app password, not the login password)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Where the published child agents run on Aetherion (their task queues)
ORCH_TASK_QUEUE_JIRA_TASK_CREATION=ea1968e2-645a-45b1-8fdf-46c0532cbb33-task-queue
ORCH_TASK_QUEUE_JIRA_REQUIREMENT_REVIEW=06ab1a2f-aa1c-4ed9-94d1-5af8ac69f5ff-task-queue

# GitHub: read-only token, the organisation watched, and the Jira project keeping its memory
GITHUB_TOKEN=
ORCH_GITHUB_ORG=AetherionAgentDemo
ORCH_GITHUB_STATE_PROJECT=BGV

# --- Optional: every setting below is at its default; uncomment to change one ---
# ORCH_TRIGGER_KEYWORD=Aetherion       the name people @mention to ask for work
# ORCH_PROCESSED_LABEL=aetherion-processed  label put on a ticket once answered
# ORCH_READ_ONLY=false                 true = never write to Jira (a safety switch)
# ORCH_BOT_ACCOUNT_ID=                 the agent's own Jira account, to ignore its comments faster
# ORCH_CLASSIFIER_PROVIDER=openai      AI provider name at the gateway
# ORCH_EMAIL_REPEAT_WINDOW=900         seconds before the same email may be sent again
# ORCH_BUILD_MIN_READINESS=3           a build waits when the last review scored below this (1-5)
# ORCH_STATUS_LABELS=true              show the ticket's state as a label (working, done…)
# ORCH_QUEUE_WAIT_MINUTES=10           how long a request waits for a running one on the ticket
# ORCH_GITHUB_BRANCH=main              the branch whose merges are passed to Planning
# ORCH_GITHUB_REPOS=                   only these repositories (default: every repo in the org)
# ORCH_GITHUB_MAX_TRIES=5              attempts to hand one GitHub event to Planning
# ORCH_PLANNING_AGENT=planning_agent   the Planning agent's name on Aetherion
# ORCH_TASK_QUEUE_PLANNING=            where the Planning agent runs (its task queue)
# ORCH_PLANNING_TIMEOUT_MINUTES=15     how long one Planning run may take
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
#
# After a build: Review -> Planning -> Coding (off until ORCH_BUILD_PIPELINE names a step)
# ORCH_BUILD_PIPELINE=                 what follows a build, in order: review,plan,code (empty = the build only)
# ORCH_PLANNING_REPOS=                 services Planning designs against: name: org/repo[@branch], separated by ;
# ORCH_CODING_AGENT=coding-agent       the Coding agent's name on Aetherion
# ORCH_TASK_QUEUE_CODING=              where the Coding agent runs (its task queue)
# ORCH_CODING_TIMEOUT_MINUTES=35       how long one Coding run may take (its change + CI)
# ORCH_CODING_ATTEMPTS=2               Coding tries in all; each retry first gets a revised design from Planning
# ORCH_PLAN_MIN_READINESS=0            Planning waits when the review scored below this (1-5); 0 never waits
# TENANT_ID=                           storage the agents share, where Planning keeps the TDD (set by the platform)
# STORAGE_AGENTS_BUCKET=               the same, where the platform names it this way
#
# A request from this agent's own form: description and files, nothing written to Jira
# ORCH_REQUEST_PROJECT=                the Jira project checked for duplicates (default: the first allowed)
# ORCH_REQUEST_MIN_READINESS=4         the review score (1-5) the document needs before Planning
# ORCH_DOCUMENT_DIR=                   laptop only: where a copy of each design is kept (set by run_local.sh)
# AETHERION_LOCAL_RUN=                 set only by scripts/local_worker.py on a laptop; never set it here
#
# Confluence: the TDD pages and their discussion (same Atlassian login as Jira unless set)
# ORCH_CONFLUENCE_URL=                 default: JIRA_BASE_URL + /wiki
# CONFLUENCE_EMAIL=                    default: JIRA_EMAIL
# CONFLUENCE_API_TOKEN=                default: JIRA_API_TOKEN
# ORCH_CONFLUENCE_SPACES=              project:space, e.g. BGV:PR,FL:FL (default: the project's own space, created if missing)
# ORCH_TDD_LABEL=aetherion-tdd         label on every TDD page; the comment check reads pages with it
# ORCH_TDD_MIN_READINESS=4             the review score (1-5) a story needs before its TDD is written

# --- Webhooks that push events here (2026-10-15; WORKFLOW.md "Webhooks") -----------------
# The platform's webhook address — the health check then prints the Jira, Confluence and
# GitHub URLs to configure. Until it is set, the health check lists what waits for it.
# ORCH_WEBHOOK_BASE_URL=https://wh.sbox.aetherion.io/webhooks/v2
# ORCH_WEBHOOK_TENANT_ID=<the tenant_id in the Jira webhook URL>
# ORCH_WEBHOOK_TENANT=test

# --- Alerts (2026-10-15) --------------------------------------------------------------------
# A chat channel's incoming webhook (Slack, Teams, …). The administrators' alerts — an agent
# that did not respond, coding that gave up, a GitHub event that could not be handed on —
# are posted there whatever ORCH_NOTIFY_ON says, and always logged as "ADMIN ALERT".
# ORCH_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/…
