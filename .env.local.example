# Local runs only. Copy to .env.local (git-ignored) and fill in; never in an agent's .env.

# OpenAI key: on a laptop the agents call OpenAI directly (on Aetherion they use the AI Gateway)
OPENAI_API_KEY=

# --- Optional: at their defaults; uncomment to change ---
# LOCAL_OPENAI_MODEL=gpt-4o   used locally when an agent names a non-OpenAI model
# LOCAL_VISION_MODEL=gpt-4o   reads images (screenshots, pictures in documents) locally

# --- Planning and Coding (scripts/run_local.sh without --jira) ---
# GitHub token: Planning reads the repositories with it, Coding pushes a branch and opens the
# pull request (needs Contents and Pull requests: read and write, on those repositories)
# GITHUB_TOKEN=
# What follows "@Aetherion build" on this laptop: review, then a design, then a pull request
# ORCH_BUILD_PIPELINE=review,plan,code
# The repositories Planning designs against, in quotes (the launcher reads this file with the shell)
# ORCH_PLANNING_REPOS="name: owner/repo[@branch]; other: owner/other"
