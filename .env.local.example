# Copy to .env.local (git-ignored). Read only by scripts/run_local.sh.
# Never put this key in an agent's own .env: that file is packed into the
# published agent. On Aetherion the AI Gateway is used and no key is needed.
OPENAI_API_KEY=
# Optional: the OpenAI model used locally for a model named for another
# provider (the Planning agent's default plan model). Default gpt-4o.
LOCAL_OPENAI_MODEL=
