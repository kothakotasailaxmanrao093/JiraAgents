# Run the local agents against another Jira site. Template only: it is committed, so no real values.
# Copy to .env.site.<name> (git-ignored), fill that in, then:
#     scripts/run_local.sh --jira --form --site <name>
# Its values win over the agents' own .env, which stays untouched.

# Jira site and the login used there (ideally your own account, invited to their site)
JIRA_BASE_URL=https://<their-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Their project key(s): where the agents may work, and the default for a run without an Issue Key
TASK_ALLOWED_PROJECT_KEYS=
ORCH_ALLOWED_PROJECT_KEYS=
JIRA_PROJECT_KEY=

# Confluence links are followed on their site only, e.g. <their-site>.atlassian.net
TASK_ALLOWED_DOMAINS=

# --- Optional: emails go to your own addresses unless set here ---
# TASK_NOTIFY_EMAILS=
# ORCH_NOTIFY_EMAILS=

# --- Optional: their GitHub, for Planning and Coding (run without --jira) ---
# GITHUB_TOKEN=          reads their repositories and opens the pull requests there
# ORCH_PLANNING_REPOS="name: owner/repo[@branch]; other: owner/other"   their repositories, in quotes
# ORCH_GITHUB_ORG=       their organization, for merges to refresh the code graph (--poll)
